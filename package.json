{
  "name": "video-sdk-service",
  "version": "0.1.0",
  "description": "Raw WebRTC video calling microservice with pluggable auth",
  "type": "module",
  "main": "dist/index.js",
  "author": "Saad Srabon",
  "scripts": {
    "predev": "node scripts/check-mediasoup-worker.mjs",
    "predev:lan": "node scripts/check-mediasoup-worker.mjs",
    "predev:lan:https": "node scripts/check-mediasoup-worker.mjs",
    "dev": "tsx watch src/index.ts",
    "dev:lan": "cross-env HOST=0.0.0.0 tsx watch src/index.ts",
    "dev:lan:https": "npm run cert && cross-env HOST=0.0.0.0 USE_HTTPS=true tsx watch src/index.ts",
    "dev:win": "npm run docker:dev",
    "build": "tsc",
    "build:sdk": "npm run build --prefix packages/client-sdk",
    "sync:simfree": "bash scripts/sync-sdk-to-simfree.sh",
    "build:meeting-demo": "esbuild examples/meeting-demo/app.js --bundle --outfile=examples/meeting-demo/bundle.js --format=esm --platform=browser",
    "build:all": "npm run build && npm run build:sdk",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck --prefix packages/client-sdk",
    "demo": "npm run build:sdk && npx --yes serve . -l tcp://0.0.0.0:5000",
    "demo:meeting": "npm run build:sdk && npm run build:meeting-demo && npx --yes serve . -l tcp://127.0.0.1:5000",
    "demo:https": "npm run build:sdk && npm run cert && npx --yes serve . -l tcp://0.0.0.0:5000 --ssl-cert certs/dev-cert.pem --ssl-key certs/dev-key.pem",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detach": "docker compose -f docker-compose.dev.yml up --build -d",
    "cert": "node scripts/generate-dev-cert.mjs 192.168.1.141",
    "turn:secret": "node scripts/generate-turn-secret.mjs",
    "token": "node --import tsx/esm scripts/generate-token.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.20.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
