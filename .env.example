# HTTP port the service listens on (1–65535)
PORT=3004

# 127.0.0.1 = localhost only (one log line, not reachable from LAN)
# Use 0.0.0.0 if you need phone/other devices on your network
HOST=127.0.0.1

# development | production | test
NODE_ENV=development

# jwt | session — which AuthAdapter to use
AUTH_MODE=jwt

# HS256 secret — must match the service that signs JWTs (min 16 chars)
JWT_SECRET=dev-jwt-secret-change-me

# Required when AUTH_MODE=session — external auth service base URL
AUTH_SERVICE_URL=http://127.0.0.1:4000

# Cookie name read when AUTH_MODE=session
SESSION_COOKIE_NAME=sessionId

# Comma-separated STUN URLs for WebRTC (empty = Google public STUN default)
STUN_URLS=stun:stun.l.google.com:19302
